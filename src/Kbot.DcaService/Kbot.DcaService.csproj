<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <UserSecretsId>b9200fc6-f2d1-4989-88b9-98debec7fd03</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lets the test project drive one investment cycle against a stubbed transport. -->
    <InternalsVisibleTo Include="Kbot.DcaService.Test" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Kbot.Common\Kbot.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
  </ItemGroup>
  <!--
    Nothing here controls which JSON files are copied to the output and publish directories, so do
    not add copy directives for them. Microsoft.NET.Sdk.Worker globs **\*.json into Content with
    CopyToOutputDirectory and CopyToPublishDirectory = PreserveNewest (and removes those files from
    None), which is what copies appsettings.json. Local secrets and state are kept out of that glob,
    and therefore out of the image, by $(DefaultItemExcludes) in ../../Directory.Build.props.
  -->
</Project>
